{
  "name": "@niu-io/workspace",
  "version": "0.2.11",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "build:dashboard": "pnpm --filter @niu-io/dashboard build",
    "build:docs": "pnpm --filter @niu-io/docs build",
    "build:catalog": "pnpm --filter @niu-io/catalog build",
    "check:catalog": "pnpm --filter @niu-io/catalog check",
    "check:dashboard": "pnpm --filter @niu-io/dashboard check",
    "check:docs": "pnpm --filter @niu-io/docs check",
    "build:sdk:js": "pnpm --filter @niu-io/sdk build",
    "check:sdk:js": "pnpm --filter @niu-io/sdk check",
    "test:sdk:js": "pnpm --filter @niu-io/sdk test",
    "build:agent-connect": "pnpm --filter @niu-io/agent-connect build",
    "check:agent-connect": "pnpm --filter @niu-io/agent-connect check",
    "test:agent-connect": "pnpm --filter @niu-io/agent-connect test",
    "build:mcp": "pnpm --filter @niu-io/mcp build",
    "check:mcp": "pnpm --filter @niu-io/mcp check",
    "test:mcp": "pnpm --filter @niu-io/mcp test",
    "dev:dashboard": "pnpm --filter @niu-io/dashboard dev",
    "dev:docs": "pnpm --filter @niu-io/docs dev",
    "dev:catalog": "pnpm --filter @niu-io/catalog dev",
    "dev": "python3 scripts/dev.py",
    "dev:stop": "python3 scripts/dev.py --stop",
    "generate:api": "python3 scripts/extract-handler-openapi.py && pnpm --filter @niu-io/docs generate:api",
    "check:api": "python3 scripts/extract-handler-openapi.py --check && pnpm --filter @niu-io/docs check:api",
    "test:backend": "cargo test --locked --workspace",
    "test:backend:functional": "cargo test --locked -p niu-gateway functional_suite:: -- --nocapture",
    "test:backend:stability": "cargo test --locked -p niu-gateway stability_suite:: -- --nocapture",
    "test:backend:performance": "cargo test --locked -p niu-gateway performance_suite:: -- --nocapture",
    "version:check": "python3 scripts/release-version.py check",
    "version:set": "python3 scripts/release-version.py set",
    "version:notes": "python3 scripts/release-version.py notes"
  }
}
