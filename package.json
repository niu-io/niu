{
  "name": "@niu-io/workspace",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "build:dashboard": "pnpm --filter @niu-io/dashboard build",
    "build:docs": "pnpm --filter @niu-io/docs build",
    "build:catalog": "pnpm --filter @niu-io/catalog build",
    "check:catalog": "pnpm --filter @niu-io/catalog check",
    "check:dashboard": "pnpm --filter @niu-io/dashboard check",
    "check:docs": "pnpm --filter @niu-io/docs check",
    "build:sdk:js": "pnpm --filter @niu-io/sdk build",
    "check:sdk:js": "pnpm --filter @niu-io/sdk check",
    "test:sdk:js": "pnpm --filter @niu-io/sdk test",
    "build:agent-connect": "pnpm --filter @niu-io/agent-connect build",
    "check:agent-connect": "pnpm --filter @niu-io/agent-connect check",
    "test:agent-connect": "pnpm --filter @niu-io/agent-connect test",
    "dev:dashboard": "pnpm --filter @niu-io/dashboard dev",
    "dev:docs": "pnpm --filter @niu-io/docs dev",
    "dev:catalog": "pnpm --filter @niu-io/catalog dev",
    "dev": "python3 scripts/dev.py",
    "dev:stop": "python3 scripts/dev.py --stop"
  }
}
