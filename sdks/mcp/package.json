{
  "name": "@niu-io/mcp",
  "version": "0.4.0",
  "description": "Stdio MCP server that calls a Niu gateway with a workspace API key",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "niu-mcp": "./bin/niu-mcp.mjs"
  },
  "files": [
    "dist",
    "bin",
    "hosted",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "node -e \"import('node:fs').then(({ rmSync }) => rmSync('dist', { recursive: true, force: true }))\" && tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm build && node --test test/*.test.mjs"
  },
  "devDependencies": {
    "typescript": "^6.0.3"
  }
}
