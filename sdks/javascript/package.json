{
  "name": "@niu-io/sdk",
  "version": "0.1.0",
  "description": "TypeScript client for the Niu AI gateway",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./admin": {
      "types": "./dist/admin.d.ts",
      "import": "./dist/admin.js"
    },
    "./generation-artifact-capture": {
      "types": "./dist/generation-artifact-capture.d.ts",
      "import": "./dist/generation-artifact-capture.js"
    },
    "./generations-sessions": {
      "types": "./dist/generations-sessions.d.ts",
      "import": "./dist/generations-sessions.js"
    },
    "./media-assets": {
      "types": "./dist/media-assets.d.ts",
      "import": "./dist/media-assets.js"
    },
    "./media-verification": {
      "types": "./dist/media-verification.d.ts",
      "import": "./dist/media-verification.js"
    },
    "./platform-audit": {
      "types": "./dist/platform-audit.d.ts",
      "import": "./dist/platform-audit.js"
    },
    "./workspace-assets": {
      "types": "./dist/workspace-assets.d.ts",
      "import": "./dist/workspace-assets.js"
    }
  },
  "files": ["dist", "examples", "README.md"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm build && node --test test/*.test.mjs"
  },
  "devDependencies": {
    "typescript": "^6.0.3"
  }
}
