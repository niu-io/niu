{
  "name": "@niu-io/collector",
  "version": "0.1.1",
  "description": "Opt-in metadata telemetry companion for coding agents",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": "./src/telemetry.mjs"
  },
  "bin": {
    "niu-agent-observability": "./bin/niu-agent-observability.mjs",
    "niu-collector": "./bin/niu-agent-observability.mjs"
  },
  "files": [
    "bin",
    "src",
    "README.md",
    "plugin.json",
    ".codex-plugin",
    "hooks",
    ".agents"
  ],
  "scripts": {
    "check": "node --check src/telemetry.mjs && node --check src/codex.mjs && node --check src/connection.mjs && node --check src/codex-hooks.mjs && node --check bin/niu-agent-observability.mjs",
    "test": "node --test test/*.test.mjs"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/niu-io/niu.git",
    "directory": "sdks/agent-observability"
  }
}
