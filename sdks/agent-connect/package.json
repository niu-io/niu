{
  "name": "@niu-io/agent-connect",
  "version": "0.3.2",
  "description": "Workspace-scoped coding-agent connectors for Niu",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "niu-agent-connect": "./bin/niu-agent-connect.mjs",
    "niu-login": "./bin/niu-login.mjs"
  },
  "files": [
    "dist",
    "bin",
    "LICENSE",
    "README.md",
    "src/auth"
  ],
  "scripts": {
    "build": "node -e \"import('node:fs').then(({ rmSync }) => rmSync('dist', { recursive: true, force: true }))\" && tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm build && node --test test/*.test.mjs"
  },
  "devDependencies": {
    "typescript": "^6.0.3"
  }
}
