# Niu runs a single unified billing and pricing workflow. Self-use bootstrap
# organizations default to unlimited credit (postpaid arrears allowed), while
# external customer accounts default to prepaid ($0 credit limit) until granted credit.
NIU_BIND=0.0.0.0:2555
POSTGRES_PASSWORD=replace-with-url-safe-random-database-password
NIU_DATABASE_URL=postgres://niu:replace-with-url-safe-random-database-password@localhost:5432/niu
NIU_DATABASE_MAX_CONNECTIONS=32
NIU_ADMIN_TOKENS=replace-with-a-different-random-32-byte-or-longer-admin-token
OPENROUTER_API_KEY=replace-with-provider-api-key
NIU_VENDOR_ENCRYPTION_KEY=replace-with-a-separate-random-32-byte-or-longer-encryption-key
# Leave blank for installation-only evaluation. Set your exact HTTPS origin
# (for example https://niu.example.com) to enable member password sign-in.
NIU_AUTH_PUBLIC_ORIGIN=

# Optional shared demo account for evaluation. It requires member authentication
# and an explicit password of at least 15 characters; startup fails when it is
# enabled without one or with the public development password. Keep it
# loopback-only or behind an https:// authentication origin, and never treat it as
# an installation administrator.
# NIU_DEMO_ACCOUNT_ENABLED=1
# NIU_DEMO_ACCOUNT_PASSWORD=replace-with-a-private-demo-password

# Optional network and routing startup controls.
# NIU_TRUSTED_PROXY_CIDRS=127.0.0.1/32,10.0.0.0/8
# NIU_ROUTING_EXPECTED_GENERATION=
# NIU_SKIP_STARTUP_MIGRATIONS=0
# Request payload capture policy: default | opt-in | disabled.
# (Avoid boolean false, which maps to opt-in rather than disabled.)
# NIU_REQUEST_PAYLOAD_CAPTURE=default

# Optional enterprise plugin composition manifest and verification key.
# NIU_ENTERPRISE_MANIFEST=
# NIU_ENTERPRISE_SIGNING_KEY=

# Opt in to bounded ark-direct-v1 video polling and prepaid reconciliation.
NIU_VIDEO_POLLING=false

# Optional Stripe Checkout integration for online account top-ups.
# Configure actual merchant credentials privately and keep test and live secrets separate.
# Omit unused variables rather than supplying blanks.
# NIU_STRIPE_MERCHANT=your-alphanumeric-merchant-id
# NIU_STRIPE_MODE=test
# NIU_STRIPE_WEBHOOK_SECRET=replace-with-stripe-webhook-signing-secret
# NIU_STRIPE_API_KEY=replace-with-stripe-api-key
# NIU_STRIPE_CURRENCY=USD
# NIU_STRIPE_SUCCESS_URL=https://niu.example/settings/billing
# NIU_STRIPE_CANCEL_URL=https://niu.example/settings/billing
# NIU_STRIPE_PAYMENT_METHODS=card
