NIU_BIND=0.0.0.0:2555
POSTGRES_PASSWORD=replace-with-url-safe-random-database-password
NIU_DATABASE_URL=postgres://niu:replace-with-url-safe-random-database-password@localhost:5432/niu
NIU_ADMIN_TOKENS=replace-with-a-different-random-32-byte-or-longer-admin-token
OPENROUTER_API_KEY=replace-with-provider-api-key
NIU_VENDOR_ENCRYPTION_KEY=replace-with-a-separate-random-32-byte-or-longer-encryption-key
# Leave blank for installation-only evaluation. Set your exact HTTPS origin
# (for example https://niu.example.com) to enable member password sign-in.
NIU_AUTH_PUBLIC_ORIGIN=

# Opt in to bounded ark-direct-v1 video polling and prepaid reconciliation.
NIU_VIDEO_POLLING=false

# Optional classic EPay integration. Configure actual merchant credentials privately.
# Callback-only operation requires PID and KEY; checkout additionally requires
# all four checkout fields. Omit unused variables rather than supplying blanks.
# NIU_EPAY_PID=your-numeric-merchant-id
# NIU_EPAY_KEY=your-private-merchant-signing-key
# NIU_EPAY_ENDPOINT=https://your-payment-gateway.example
# NIU_EPAY_NOTIFY_URL=https://niu.example/payments/epay/notify
# NIU_EPAY_RETURN_URL=https://niu.example/settings/billing
# NIU_EPAY_METHODS=alipay,wxpay
