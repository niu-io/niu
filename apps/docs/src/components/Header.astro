---
import NiuBrand from '../../../dashboard/app/components/NiuBrand';
import Search from '@astrojs/starlight/components/Search.astro';
import ThemeSelect from './ThemeSelect.astro';
import SessionLink from './SessionLink';
import { publicNavigationActive, documentationNavigation } from '../navigation';
const links = documentationNavigation;
const navZh: Record<string, string> = {
  'Docs': '文档',
  'AgentDoc': 'AgentDoc',
  'Why Niu?': '为什么选择 Niu？',
  Blog: '博客',
  Models: '模型',
  API: 'API',
  SDK: 'SDK',
  Compare: '对比',
};
---
<div class="docs-header">
  <a class="docs-brand" href="/" aria-label="Niu home"><span class="docs-public-name"><NiuBrand /></span></a>
  <nav aria-label="Documentation navigation">{links.map(({label, href}) => <a href={href} aria-current={publicNavigationActive(Astro.url.pathname, label) ? 'page' : undefined} data-i18n-en={label} data-i18n-zh={navZh[label] ?? label}><span data-lang="en">{label}</span><span data-lang="zh">{navZh[label] ?? label}</span></a>)}</nav>
  <div class="public-session" transition:persist="docs-session"><SessionLink client:load /></div>
  <div class="docs-header-tools">
    <!-- Starlight initializes search on DOMContentLoaded. Keep that instance
         across ClientRouter swaps. -->
    <div class="contents" data-docs-search transition:persist="docs-search"><Search /></div>
    <div class="contents" transition:persist="docs-theme"><ThemeSelect /></div>
  </div>
</div>
<script>
  import type { TransitionBeforeSwapEvent } from 'astro:transitions/client';

  document.addEventListener('astro:before-swap', (event: TransitionBeforeSwapEvent) => {
    // Astro inserts the incoming tree before moving persisted elements. Do not
    // briefly upgrade a discarded site-search: its global shortcut has no teardown.
    if (document.querySelector('[data-docs-search]')) {
      event.newDocument.querySelector('[data-docs-search]')?.replaceChildren();
    }
  });
  // Keep site-search inside .docs-header-tools so the header trigger button stays
  // anchored across Astro ClientRouter transitions, while detaching ONLY its modal
  // <dialog> into document.body so hidden mobile headers never suppress
  // the open top-layer search dialog.
  const ensureDialogInBody = () => {
    const search = document.querySelector('site-search');
    const dialog =
      search?.querySelector<HTMLDialogElement>('dialog') ??
      document.querySelector<HTMLDialogElement>('dialog[aria-label="Search"], dialog:has(#starlight__search)');
    if (dialog && dialog.parentElement !== document.body) {
      dialog.dataset.docsSearchDialog = 'true';
      document.body.appendChild(dialog);
    }
    return dialog;
  };
  document.addEventListener('click', event => {
    const target = event.target instanceof Element ? event.target : null;
    if (target?.closest('site-search button')) ensureDialogInBody();
  }, true);
  document.addEventListener('keydown', event => {
    if ((event.metaKey || event.ctrlKey) && event.key.toLowerCase() === 'k') {
      ensureDialogInBody();
    }
  }, true);
  document.addEventListener('astro:page-load', () => {
    ensureDialogInBody();
    const url = new URL(location.href);
    if (url.searchParams.get('search') !== '1') return;
    const trigger = document.querySelector<HTMLButtonElement>('site-search button');
    if (!trigger) return;
    url.searchParams.delete('search');
    history.replaceState(history.state, '', url.pathname + url.search + url.hash);
    trigger.click();
    const focusSearch = () => {
      const input = document.querySelector<HTMLInputElement>('#starlight__search .pagefind-ui__search-input');
      if (!input) return false;
      input.focus();
      return true;
    };
    if (!focusSearch()) {
      let attempts = 0;
      const timer = window.setInterval(() => {
        if (focusSearch() || ++attempts > 20) window.clearInterval(timer);
      }, 50);
    }
  });
</script>
