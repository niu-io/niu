---
import MarkdownContent from '@astrojs/starlight/components/MarkdownContent.astro';
import AgentDocModes from './AgentDocModes';
import OperationTryIt from './live-api/OperationTryIt';
import { indexPublicOperations, type OpenApiDocument, type OperationDescriptor } from './live-api/openapi';
import { readFile } from 'node:fs/promises';
import { resolve } from 'node:path';

let cachedRestOperations: Map<string, OperationDescriptor> | null = null;
async function getRestOperations(): Promise<Map<string, OperationDescriptor>> {
  if (cachedRestOperations) return cachedRestOperations;
  const raw = await readFile(resolve('..', '..', 'contracts', 'generated', 'public-openapi.json'), 'utf8');
  const parsed = JSON.parse(raw) as OpenApiDocument;
  cachedRestOperations = indexPublicOperations(parsed).bySlug;
  return cachedRestOperations;
}

const agentMatch = Astro.url.pathname.match(/^\/docs\/agents(?:\/([^/]+))?\/?$/);
const name = agentMatch?.[1];
const file = name === 'capabilities' ? 'agents' : name === 'routing' ? 'pools' : name;
const valid = Boolean(file && ['install', 'agents', 'inference', 'pools', 'evaluations', 'events'].includes(file));
const source = agentMatch ? await readFile(valid ? resolve('public', `${file}.md`) : resolve('public', 'llms.txt'), 'utf8') : '';
const raw = agentMatch ? (valid ? `/docs/${file}.md` : '/docs/llms.txt') : undefined;
const cleanSource = source.replace(/^---\r?\n[\s\S]*?\r?\n---\r?\n/, '');

const restMatch = Astro.url.pathname.match(/^\/docs\/api\/rest\/([^/]+)\/?$/);
const restOperation = restMatch?.[1]
  ? (await getRestOperations()).get(restMatch[1].toLowerCase()) ?? null
  : null;
---
{agentMatch ? (
  <AgentDocModes client:load source={cleanSource} raw={raw}><MarkdownContent><slot /></MarkdownContent></AgentDocModes>
) : restOperation ? (
  <>
    <OperationTryIt client:load operation={restOperation} defaultExpanded={false} />
    <MarkdownContent><slot /></MarkdownContent>
  </>
) : (
  <MarkdownContent><slot /></MarkdownContent>
)}
