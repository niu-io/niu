    // Generated API / SDK headings & group labels
    'SDK interfaces': 'SDK 接口',
    'Start with a tutorial': '从教程开始',
    'Model APIs': '模型推理 API',
    'Video and media APIs': '视频与媒体 API',
    'Providers and routing APIs': '模型供应商与路由 API',
    'Authentication and sessions': '认证与会话 API',
    'Workspace and company APIs': '工作空间与组织 API',
    'Service endpoints': '服务端点',
    'Authentication': '身份认证',
    'HTTP request': 'HTTP 请求',
    'Parameters': '请求参数',
    'Request body': '请求体',
    'Responses': '响应结果',
    'Behavior and supported scope': '行为说明与支持范围',
    'Clients and functions': '客户端与函数',
    'Request, response, and configuration types': '请求、响应与配置类型',
    'Constructor and members': '构造函数与成员',
  };

  const EXACT_BLOCK_ZH: Record<string, string> = {
    'Generated from the checked-in source. Do not edit this reference by hand.': '由代码仓库中的源码与契约自动生成，请勿手动编辑本参考页面。',
    'Generated from backend handler annotations. Do not edit directly.': '由后端路由处理器注解自动生成，请勿直接编辑。',
    'No OpenAPI security scheme is required. Other request validation still applies.': '无需 OpenAPI 安全认证方案，但其他请求校验规则仍然生效。',
    'No OpenAPI security scheme is required. Signature and other request validation still apply as described above.': '无需 OpenAPI 安全认证方案，但上文所述的签名及其他请求校验规则仍然生效。',
    'Use the credential and permission scope described above. Each object below is an alternative; schemes within one object are required together.': '请使用上文说明的凭据与权限范围。下方数组中的每个对象代表一种可选认证方式；同一对象内的所有方案需同时满足。',
    'Each array entry is an alternative; schemes within one entry are required together.': '数组中的每一项代表一种可选认证方式；同一项内的所有方案需同时满足。',
    'No path, query, or header parameters are declared.': '未声明路径参数、查询参数或请求头参数。',
    'No request body is declared.': '未声明请求体。',
    'Required.': '必填。',
    'Optional.': '可选。',
    'Example:': '示例：',
    'Response headers:': '响应头：',
    'The contract includes endpoints with explicit limitations or stub status. Read the scope on each operation.': '契约中包含带有明确限制说明或桩（stub）状态的端点，请仔细阅读每个操作的支持范围。',
    'The reference is emitted from the TypeScript SDK source, including inferred return types. Import the public exports from `@niu-io/sdk`.': '本参考文档由 TypeScript SDK 源码（含推导出的返回类型）自动生成。请从 `@niu-io/sdk` 导入公开符号。',
    'Download OpenAPI JSON': '下载 OpenAPI JSON',
    'Download the full OpenAPI JSON': '下载完整 OpenAPI JSON',
    'Download the annotated OpenAPI JSON': '下载已注解的 OpenAPI JSON',
    'SDK source': 'SDK 源码',
    'All SDK types': '所有 SDK 类型',
  };

  function translation(dictionary: Record<string, string>, key: string): string | undefined {
    return Object.hasOwn(dictionary, key) && typeof dictionary[key] === 'string'
      ? dictionary[key] : undefined;
  }

  function rememberOriginalText(el: Element): string {
    const htmlEl = el as HTMLElement;
    if (htmlEl.dataset.origText === undefined) {
      htmlEl.dataset.origText = (el.textContent || '').trim();
    }
    return htmlEl.dataset.origText;
  }

  function buildHighlightedPathCode(routePath: string): HTMLElement {
    const codeEl = document.createElement('code');
    codeEl.className = 'docs-http-path';
    const parts = routePath.split(/(\{[^}]+\})/g);
    for (const part of parts) {
      if (!part) continue;
      if (part.startsWith('{') && part.endsWith('}')) {
        const paramSpan = document.createElement('span');
        paramSpan.className = 'docs-http-param';
        paramSpan.textContent = part;
        codeEl.appendChild(paramSpan);
      } else {
        codeEl.appendChild(document.createTextNode(part));
      }
    }
    return codeEl;
  }

  function enhanceApiReferenceDom(isZh: boolean) {
    const content = document.querySelector<HTMLElement>('.sl-markdown-content');
    if (!content) return;

    // 1. Style auto-generated notice banner
    const firstParagraph = content.querySelector<HTMLElement>(':scope > p:first-of-type');
    if (firstParagraph) {
      const orig = firstParagraph.dataset.origText ?? (firstParagraph.textContent || '').trim();
      if (
        orig.startsWith('Generated from the checked-in source') ||
        orig.startsWith('Generated from backend handler annotations') ||
        orig.startsWith('由代码仓库中的源码与契约自动生成') ||
        orig.startsWith('由后端路由处理器注解自动生成')
      ) {
        firstParagraph.classList.add('docs-generated-notice');
      }
    }

    // 2. Transform REST endpoint index list links: `METHOD /route` — Summary
    content.querySelectorAll<HTMLAnchorElement>('ul > li > a').forEach((anchor) => {
      if (anchor.dataset.apiEnhanced === '1') return;
      const firstChild = anchor.firstElementChild;
      if (!firstChild || firstChild.tagName !== 'CODE') return;
      const codeText = (firstChild.textContent || '').trim();
      const match = codeText.match(/^(GET|POST|PUT|PATCH|DELETE|HEAD|OPTIONS)\s+(\/\S+)$/);
      if (!match) return;

      const [, method, routePath] = match;
      const fullText = (anchor.textContent || '').trim();
      const summary = fullText.slice(codeText.length).replace(/^\s*[—–-]\s*/, '').trim();

      anchor.dataset.apiEnhanced = '1';
      anchor.classList.add('docs-api-endpoint-link');
      anchor.parentElement?.classList.add('docs-api-endpoint-item');
      anchor.closest('ul')?.classList.add('docs-api-endpoint-list');

      const badge = document.createElement('span');
      badge.className = 'docs-http-badge';
      badge.dataset.method = method.toLowerCase();
      badge.textContent = method;

      const pathCode = buildHighlightedPathCode(routePath);

      const summarySpan = document.createElement('span');
      summarySpan.className = 'docs-http-summary';
      summarySpan.textContent = summary;

      anchor.replaceChildren(badge, pathCode, summarySpan);
    });

    // 3. Transform individual REST operation signature `<p><code>METHOD /route</code></p>` into signature bar
    content.querySelectorAll<HTMLElement>(':scope > p').forEach((paragraph) => {
      if (paragraph.children.length !== 1 || paragraph.firstElementChild?.tagName !== 'CODE') return;
      const rawText = (paragraph.textContent || '').trim();
      const onlyCodeText = (paragraph.firstElementChild.textContent || '').trim();
      if (rawText !== onlyCodeText) return;
      const match = onlyCodeText.match(/^(GET|POST|PUT|PATCH|DELETE|HEAD|OPTIONS)\s+(\/\S+)$/);
      if (!match) return;

      const [, method, routePath] = match;
      const bar = document.createElement('div');
      bar.className = 'docs-api-signature-bar not-content';

      const left = document.createElement('div');
      left.className = 'docs-api-signature-main';

      const badge = document.createElement('span');
      badge.className = 'docs-http-badge';
      badge.dataset.method = method.toLowerCase();
      badge.textContent = method;

      const pathCode = buildHighlightedPathCode(routePath);
      left.append(badge, pathCode);

      const copyBtn = document.createElement('button');
      copyBtn.type = 'button';
      copyBtn.className = 'docs-api-copy-path';
      copyBtn.dataset.route = routePath;
      copyBtn.textContent = isZh ? '复制路径' : 'Copy path';
      copyBtn.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(routePath);
          copyBtn.dataset.copied = '1';
          copyBtn.textContent = document.documentElement.dataset.locale === 'zh-CN' ? '已复制' : 'Copied';
          window.setTimeout(() => {
            delete copyBtn.dataset.copied;
            copyBtn.textContent = document.documentElement.dataset.locale === 'zh-CN' ? '复制路径' : 'Copy path';
          }, 1600);
        } catch {
          // Ignore clipboard errors
        }
      });

      bar.append(left, copyBtn);
      paragraph.replaceWith(bar);
    });

    // Update localized label on already-enhanced signature copy button
    content.querySelectorAll<HTMLButtonElement>('.docs-api-copy-path').forEach((btn) => {
      if (btn.dataset.copied === '1') {
        btn.textContent = isZh ? '已复制' : 'Copied';
      } else {
        btn.textContent = isZh ? '复制路径' : 'Copy path';
      }
    });

    // 4. Tag HTTP status response headings (e.g. `HTTP 200`, `HTTP 400`, `HTTP 503`)
    content.querySelectorAll<HTMLElement>('h3').forEach((h3) => {
      const text = (h3.textContent || '').trim();
      const statusMatch = text.match(/^HTTP\s+(\d)\d{2}$/);
      if (statusMatch) {
        h3.dataset.httpStatusGroup = `${statusMatch[1]}xx`;
      }
    });
  }

  function localizeGeneratedContent(isZh: boolean) {
    const content = document.querySelector('.sl-markdown-content');
    if (!content) return;
    // Skip if page uses authored [data-lang] blocks
    if (content.querySelector('[data-lang="zh"]')) return;

    // Headings inside generated pages
    content.querySelectorAll<HTMLElement>('h2, h3').forEach((heading) => {
      const orig = rememberOriginalText(heading);
      const zh = translation(SIDEBAR_AND_TITLE_ZH, orig);
      if (zh) {
        heading.textContent = isZh ? zh : orig;
      }
    });

    // Paragraphs and list links in generated pages
    content.querySelectorAll<HTMLElement>('p, a').forEach((el) => {
      if (el.children.length === 0) {
        const orig = rememberOriginalText(el);
        const zh = translation(EXACT_BLOCK_ZH, orig) ?? translation(SIDEBAR_AND_TITLE_ZH, orig);
        if (zh) {
          el.textContent = isZh ? zh : orig;
          return;
        }
      }
      // Handle parameterized paragraphs in generated REST/SDK docs without destroying child code/strong/a nodes
      if (el.tagName === 'P') {
        if (el.dataset.origHtml === undefined) {
          el.dataset.origHtml = el.innerHTML;
        }
        if (!isZh) {
          el.innerHTML = el.dataset.origHtml;
          return;
        }
        let html = el.dataset.origHtml;
        html = html
          .replace(/^Operation: <code[^>]*>([^<]+)<\/code>\.$/, '操作 ID：<code>$1</code>。')
          .replace(/^Implementation: <code[^>]*>([^<]+)<\/code>\. Operation: <code[^>]*>([^<]+)<\/code>\.$/, '实现状态：<code>$1</code> · 操作 ID：<code>$2</code>。')
          .replace(/^Authentication alternative: (.+)\.$/, '可选认证方案：$1。')
          .replace(/^Content type: <code[^>]*>([^<]+)<\/code>\.$/, '内容类型：<code>$1</code>。')
          .replace(/^Response header: <code[^>]*>([^<]+)<\/code>\.$/, '响应头：<code>$1</code>。')
          .replace(/^Location: <strong>([^<]+)<\/strong>\. <strong>Required\.<\/strong>/, '参数位置：<strong>$1</strong> · <strong>必填。</strong>')
          .replace(/^Location: <strong>([^<]+)<\/strong>\. Optional\./, '参数位置：<strong>$1</strong> · 可选。')
          .replace(/^<strong>Supported scope:<\/strong> /, '<strong>支持范围：</strong>')
          .replace(
            /^Set <code[^>]*>NIU_ORIGIN<\/code> to your installation origin \(without <code[^>]*>\/v1<\/code>\)\. Replace path, query and header placeholders with the required values\. Query examples use curl 7\.87 or newer to encode values with <code[^>]*>--url-query<\/code>\. Use the credential scope described above; a bearer token must have the authority required by this operation\.$/,
            '将 <code>NIU_ORIGIN</code> 设置为您的部署源地址（不含 <code>/v1</code>），并将路径、查询参数和请求头占位符替换为实际值。查询参数示例使用 curl 7.87+ 的 <code>--url-query</code> 进行安全编码。请使用上文说明的凭据权限范围；Bearer 令牌必须具备该操作所需的授权。',
          )
          .replace(
            /^Set <code[^>]*>NIU_ORIGIN<\/code> to your installation origin \(without <code[^>]*>\/v1<\/code>\)\. Replace path placeholders with the references required by this operation\. Use the credential scope described above\.$/,
            '将 <code>NIU_ORIGIN</code> 设置为您的部署源地址（不含 <code>/v1</code>），将路径占位符替换为该操作所需的实际标识，并使用上文说明的凭据权限范围。',
          )
          .replace(
            /^Set <code[^>]*>NIU_ORIGIN<\/code> to your installation origin \(without <code[^>]*>\/v1<\/code>\)\. Replace path and required-header placeholders with the values required by this operation\. Use the credential scope described above\.$/,
            '将 <code>NIU_ORIGIN</code> 设置为您的部署源地址（不含 <code>/v1</code>），将路径和必填请求头占位符替换为该操作所需的实际值，并使用上文说明的凭据权限范围。',
          )
          .replace(
            ' — public constructors, methods, inputs and return types emitted by the TypeScript compiler.',
            ' — 由 TypeScript 编译器生成的公开构造函数、方法、输入参数与返回类型。',
          )
          .replace(
            / — (\d+) operations, including authentication, parameters, request bodies and response schemas from the bundled OpenAPI contract\./,
            ' — 共 $1 个接口操作，包含打包 OpenAPI 契约中的认证方式、请求参数、请求体与响应结构。',
          )
          .replace(
            ' are in the Docs guide directory.',
            ' 位于文档指南目录中。',
          )
          .replace(
            ' Authentication, parameters, request bodies and response schemas below come from that same contract.',
            ' 下方的身份认证、请求参数、请求体与响应结构均源自同一份契约。',
          )
          .replace(
            /^The reference is emitted from the TypeScript SDK source, including inferred return types\. Import the public exports from <code[^>]*>@niu-io\/sdk<\/code>\.$/,
            '本参考文档由 TypeScript SDK 源码（含推导出的返回类型）自动生成。请从 <code>@niu-io/sdk</code> 导入公开导出项。',
          );
        if (html !== el.innerHTML) {
          el.innerHTML = html;
        }
      }
    });
  }

  function syncTocForActiveLocale(isZh: boolean) {
    const content = document.querySelector('.sl-markdown-content');
    const langBlock = content?.querySelector<HTMLElement>(isZh ? '[data-lang="zh"]' : '[data-lang="en"]');
    const tocNavs = Array.from(
      document.querySelectorAll<HTMLElement>('starlight-toc nav, mobile-starlight-toc nav'),
    );

    // Localize "On this page" heading (desktop & mobile)
    document
      .querySelectorAll<HTMLElement>('.right-sidebar-panel h2, mobile-starlight-toc summary .toggle')
      .forEach((h2) => {
        const orig = rememberOriginalText(h2);
        if (orig === 'On this page') {
          h2.textContent = isZh ? '本页目录' : 'On this page';
        }
      });

    // Localize mobile TOC current-section indicator
    document.querySelectorAll<HTMLElement>('mobile-starlight-toc .display-current').forEach((curr) => {
      const text = (curr.textContent || '').trim();
      if (text === 'Overview' || text === '概览') {
        curr.textContent = isZh ? '概览' : 'Overview';
      } else {
        const zh = translation(SIDEBAR_AND_TITLE_ZH, text);
        if (isZh && zh) curr.textContent = zh;
      }
    });

    if (!tocNavs.length) return;

    if (!langBlock) {
      // Generated page without dual [data-lang] blocks: update TOC link text to match localized headings
      for (const tocNav of tocNavs) {
        tocNav.querySelectorAll<HTMLAnchorElement>('a[href^="#"]').forEach((link) => {
          const id = decodeURIComponent(link.getAttribute('href')!.slice(1));
          if (id === '_top') {
            const span = link.querySelector('span') || link;
            const orig = rememberOriginalText(span);
            if (orig === 'Overview') span.textContent = isZh ? '概览' : 'Overview';
            return;
          }
          const target = document.getElementById(id);
          if (target) {
            const span = link.querySelector('span') || link;
            span.textContent = (target.textContent || '').trim();
          }
        });
      }
      return;
    }

    // Dual-language MDX page: filter TOC items so only headings inside the active [data-lang] block are shown
    const activeHeadings = Array.from(langBlock.querySelectorAll<HTMLElement>('h2[id], h3[id]'));
    const activeIds = new Set(activeHeadings.map((h) => h.id));
    activeIds.add('_top');

    for (const tocNav of tocNavs) {
      tocNav.querySelectorAll<HTMLAnchorElement>('a[href^="#"]').forEach((link) => {
        const id = decodeURIComponent(link.getAttribute('href')!.slice(1));
        const li = link.closest('li');
        if (!li) return;
        if (id === '_top') {
          li.style.display = '';
          const span = link.querySelector('span') || link;
          const orig = rememberOriginalText(span);
          if (orig === 'Overview') span.textContent = isZh ? '概览' : 'Overview';
          return;
        }
        const inActive = activeIds.has(id);
        li.style.display = inActive ? '' : 'none';
      });
    }
  }

  function localizeSearchModal(isZh: boolean) {
    const input = document.querySelector<HTMLInputElement>('#starlight__search .pagefind-ui__search-input');
    if (input) {
      const nextPlaceholder = isZh
        ? '搜索文档、API 端点或 SDK 类型…'
        : 'Search guides, API endpoints, or SDK types…';
      if (input.placeholder !== nextPlaceholder) {
        input.placeholder = nextPlaceholder;
      }
    }
    const clearBtn = document.querySelector<HTMLButtonElement>('#starlight__search .pagefind-ui__search-clear');
    if (clearBtn) {
      const nextClear = isZh ? '清除搜索' : 'Clear search';
      if (clearBtn.getAttribute('aria-label') !== nextClear) {
        clearBtn.setAttribute('aria-label', nextClear);
      }
    }
  }

  function applyDocsLocale() {
    const isZh = document.documentElement.dataset.locale === 'zh-CN';

    // 1. SiteTitle & article section eyebrow
    document.querySelectorAll<HTMLElement>('.site-title').forEach((el) => {
      const orig = rememberOriginalText(el);
      if (orig === 'Documentation') {
        el.textContent = isZh ? '文档' : 'Documentation';
      }
    });
    document.querySelectorAll<HTMLElement>('.docs-article-eyebrow').forEach((el) => {
      const orig = rememberOriginalText(el);
      const zh = translation(SIDEBAR_AND_TITLE_ZH, orig);
      if (zh) {
        el.textContent = isZh ? zh : orig;
      }
    });

    // 2. Search button in header & search modal
    document.querySelectorAll<HTMLElement>('site-search button').forEach((btn) => {
      const label = isZh ? '搜索文档 (⌘K)' : 'Search documentation (⌘K)';
      btn.setAttribute('aria-label', isZh ? '搜索' : 'Search');
      btn.setAttribute('title', label);
      const labelSpan = btn.querySelector<HTMLElement>('span:not(.sl-sr-only)');
      if (labelSpan) {
        const orig = rememberOriginalText(labelSpan);
        if (orig === 'Search') labelSpan.textContent = isZh ? '搜索' : 'Search';
      }
    });
    localizeSearchModal(isZh);

    // 3. Sidebar group labels, sidebar links, and mobile public nav
    document.querySelectorAll<HTMLElement>(
      '.sidebar-content summary span.large, .sidebar-content a span, .docs-mobile-public nav a'
    ).forEach((el) => {
      const orig = rememberOriginalText(el);
      const zh = translation(SIDEBAR_AND_TITLE_ZH, orig);
      if (zh) {
        el.textContent = isZh ? zh : orig;
      }
    });

    // 4. Page title (h1#_top)
    const h1 = document.querySelector<HTMLElement>('h1#_top');
    if (h1) {
      const origTitle = rememberOriginalText(h1);
      const zhBlock = document.querySelector<HTMLElement>('.sl-markdown-content [data-lang="zh"][data-title-zh]');
      const zhTitle = zhBlock?.dataset.titleZh || translation(SIDEBAR_AND_TITLE_ZH, origTitle);
      if (zhTitle) {
        h1.textContent = isZh ? zhTitle : origTitle;
      }
    }

    // 5. Pagination links (Previous / Next + link titles)
    document.querySelectorAll<HTMLElement>('.pagination-links a').forEach((link) => {
      const rel = link.getAttribute('rel');
      const titleSpan = link.querySelector<HTMLElement>('.link-title');
      if (titleSpan) {
        const orig = rememberOriginalText(titleSpan);
        const zh = translation(SIDEBAR_AND_TITLE_ZH, orig);
        if (zh) titleSpan.textContent = isZh ? zh : orig;
      }
      // Replace the text node before <br> ("Previous" / "Next")
      for (const node of Array.from(link.childNodes)) {
        if (node.nodeType === Node.TEXT_NODE && node.textContent && node.textContent.trim().length > 0) {
          if (rel === 'prev') {
            node.textContent = isZh ? '\n          上一页\n          ' : '\n          Previous\n          ';
          } else if (rel === 'next') {
            node.textContent = isZh ? '\n          下一页\n          ' : '\n          Next\n          ';
          }
          break;
        }
      }
    });

    // 6. Generated API / SDK / Handler reference pages + visual API widgets
    localizeGeneratedContent(isZh);
    enhanceApiReferenceDom(isZh);

    // 7. Right-side & Mobile Table of Contents
    syncTocForActiveLocale(isZh);
  }

  function observeSearchAndMobileToc() {
    const searchRoot = document.getElementById('starlight__search');
    if (searchRoot && !searchRoot.dataset.localeObserved) {
      searchRoot.dataset.localeObserved = '1';
      new MutationObserver(() => {
        localizeSearchModal(document.documentElement.dataset.locale === 'zh-CN');
      }).observe(searchRoot, { childList: true, subtree: true });
    }

    const mobileCurr = document.querySelector<HTMLElement>('mobile-starlight-toc .display-current');
    if (mobileCurr && !mobileCurr.dataset.localeObserved) {
      mobileCurr.dataset.localeObserved = '1';
      new MutationObserver(() => {
        const isZh = document.documentElement.dataset.locale === 'zh-CN';
        const text = (mobileCurr.textContent || '').trim();
        if (isZh && text === 'Overview') {
          mobileCurr.textContent = '概览';
        } else if (!isZh && text === '概览') {
          mobileCurr.textContent = 'Overview';
        }
      }).observe(mobileCurr, { childList: true, characterData: true, subtree: true });
    }
  }

  function syncDocsSurface() {
    applyDocsLocale();
    observeSearchAndMobileToc();
  }

  syncDocsSurface();
  window.addEventListener('niu:locale', syncDocsSurface);
  window.addEventListener('niu-locale-change', syncDocsSurface);
  window.addEventListener('storage', syncDocsSurface);
  document.addEventListener('astro:after-swap', syncDocsSurface);
  document.addEventListener('astro:page-load', syncDocsSurface);

  if (document.documentElement.hasAttribute('data-docs-embedded')) {
    // The dashboard owns browser history; Astro swaps articles without blanking
    // the iframe or rebuilding the documentation shell.
    window.addEventListener('message', (event) => {
      if (event.origin !== location.origin || event.source !== parent) return;
      if (event.data?.type === 'niu-docs-locale' && (event.data.locale === 'en' || event.data.locale === 'zh-CN')) {
        document.documentElement.dataset.locale = event.data.locale;
        document.documentElement.lang = event.data.locale;
        window.dispatchEvent(new CustomEvent('niu:locale', { detail: event.data.locale }));
        syncDocsSurface();
        return;
      }
      if (event.data?.type !== 'niu-docs-navigate' || typeof event.data.path !== 'string') return;
      const url = new URL(event.data.path, location.origin);
      if (url.origin === location.origin && url.pathname.startsWith('/docs/')) {
        url.searchParams.set('embed', 'help');
        void navigate(url.pathname + url.search + url.hash, { history: 'replace' });
      }
    });
    window.addEventListener('click', (event) => {
      const link = event.target instanceof Element ? event.target.closest<HTMLAnchorElement>('a[href]') : null;
      if (!link || event.defaultPrevented || event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey || link.target || link.hasAttribute('download')) return;
      const url = new URL(link.href, location.href);
      url.searchParams.delete('embed');
      if (url.origin === location.origin && link.classList.contains('docs-brand') && url.pathname === '/') {
        event.preventDefault();
        parent.postMessage({ type: 'niu-docs-navigation', path: '/docs/' }, location.origin);
      } else if (url.origin === location.origin && url.pathname.startsWith('/docs/')) {
        event.preventDefault();
        parent.postMessage({ type: 'niu-docs-navigation', path: url.pathname + url.search + url.hash }, location.origin);
      } else if (url.origin === location.origin) {
        link.target = '_top';
      } else {
        link.target = '_blank';
        link.rel = 'noopener';
      }
    }, { capture: true });
  }
</script>
