---
import { ClientRouter } from 'astro:transitions';
import PageFrame from '@astrojs/starlight/components/PageFrame.astro';
---
<ClientRouter />
<PageFrame><slot name="header" slot="header" /><slot name="sidebar" slot="sidebar" /><slot /></PageFrame>
<script>
  import { navigate } from 'astro:transitions/client';

  const SIDEBAR_AND_TITLE_ZH: Record<string, string> = {
    // Sidebar groups & public nav
    'Start here': '快速开始',
    'Use Niu': '使用牛元',
    'Administration': '平台管理',
    'Operate Niu': '运维与部署',
    'API': 'API',
    'SDK': 'SDK',
    'Compare': '对比',
    'Models': '模型目录',
    'Docs': '文档',
    'Documentation': '文档',
    // Sidebar links & page titles
    'Overview': '概览',
    'Quickstart': '快速入门',
    'API tutorial': 'API 教程',
    'SDK tutorial': 'SDK 教程',
    'Coding agents': '编程智能体 (MCP)',
    'Coding agents (MCP)': '编程智能体 (MCP)',
    'Models & routing': '模型与路由',
    'Generations': '生成对话与视频',
    'Video generation': '视频生成',
    'Request logs': '请求日志',
