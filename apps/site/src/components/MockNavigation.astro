---
interface Props {
  active: number;
}
const { active } = Astro.props;
const items = [
  { name: "Connections", path: "M8 12h8M8 8H5v8h3m8-8h3v8h-3M12 4v4m0 8v4" },
  { name: "Tasks", path: "M9 6h11M9 12h11M9 18h11M4 6h.01M4 12h.01M4 18h.01" },
  {
    name: "Model fusion",
    path: "M5 5v4c0 3 7 3 7 6v4M19 5v4c0 3-7 3-7 6M9 17l3 3 3-3",
  },
];
---

<aside class="mock-nav-rail" aria-label="Illustrated navigation">
  <span class="mock-nav-home" title="niu.io">
    <img
      src="/site-assets/brand/niu-mark.png"
      alt="niu.io"
      width="28"
      height="28"
    />
  </span>
  <div class="mock-nav-items">
    {items.map((item, i) => (
      <span
        class:list={{ "is-active": active === i }}
        role="img"
        aria-label={`${item.name}${active === i ? " (selected)" : ""}`}
        title={item.name}
      >
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d={item.path} />
        </svg>
      </span>
    ))}
  </div>
  <span
    class="mock-nav-profile"
    role="img"
    aria-label="Account"
    title="Account"
  >
    <svg viewBox="0 0 24 24" aria-hidden="true">
      <circle cx="12" cy="8" r="3" />
      <path d="M5 20v-2a7 7 0 0 1 14 0v2" />
    </svg>
  </span>
</aside>
