---
import Benchmark from "../components/Benchmark.astro";
import MockNavigation from "../components/MockNavigation.astro";
import ValueSlider from "../components/ValueSlider.astro";
import SiteLayout from "../layouts/SiteLayout.astro";
import { links, capabilities, faqs, requestExample } from "../content/landing";

const title = "niu.io — The Agent Gateway for complex tasks";
const description =
  "An open-source Agent Gateway for model access, execution visibility, and evidence-based model choices. Understand multi-step agent tasks, compare model choices, and evaluate the cost of successful outcomes.";
const spans = [
  { name: "Task", kind: "Execution", offset: 0, width: 100, duration: "100 ms" },
  { name: "Agent A", kind: "Parallel branch", offset: 0, width: 70, duration: "70 ms" },
  { name: "Agent B", kind: "Parallel branch", offset: 10, width: 80, duration: "80 ms" },
  { name: "Validation", kind: "Outcome evidence", offset: 90, width: 10, duration: "10 ms" },
];
---
<SiteLayout title={title} description={description}>
  <main id="main">
      <section class="hero container" aria-labelledby="hero-title">
        <div class="hero-copy">
          <a class="release-link" href="#release">
            <span class="status-dot"></span>First release in development
            <span aria-hidden="true">→</span>
          </a>
          <h1 id="hero-title">
            The Agent Gateway
            <br />
            for <span class="accent">complex tasks.</span>
          </h1>
          <p class="hero-description">
            A cheaper model can take more attempts. A stronger model can finish
            sooner and still cost more. Niu connects model access with task-level
            evidence—so you can work toward the right balance of time, cost and
            quality.
          </p>
          <div class="actions">
            <a class="button primary" href={links.quickstart}>
              Try the development build <span aria-hidden="true">→</span>
            </a>
            <a class="button secondary" href="#benchmark">
              Explore a benchmark <span aria-hidden="true">↗</span>
            </a>
          </div>
          <p class="hero-note">Open source · Self-hosted · Development preview</p>
          <p class="hero-availability">
            Evaluate model access and task investigation today.
            <a href="#release">Benchmarking and fusion are in development →</a>
          </p>
        </div>
        <div class="hero-visual" role="img" aria-label="Illustrative task evidence with synthetic data">
          <div class="hero-visual-head">
            <span class="hero-visual-mark" aria-hidden="true"></span>
            <strong>Task investigation</strong>
            <span class="sample-label">Synthetic data</span>
          </div>
          <div class="hero-task-summary">
            <div>
              <span>Imported task</span>
              <strong>Search result deduplication</strong>
            </div>
            <span class="hero-review">Needs review</span>
          </div>
          <div class="hero-trace" aria-label="Three illustrative task stages">
            <div>
              <span class="trace-glyph">↳</span>
              <span><strong>Planning</strong><small>Agent · 2 model calls</small></span>
              <b>00:42</b>
            </div>
            <div>
              <span class="trace-glyph">↳</span>
              <span><strong>Implementation</strong><small>2 parallel branches</small></span>
              <b>01:18</b>
            </div>
            <div>
              <span class="trace-glyph trace-warning">!</span>
              <span><strong>Validation</strong><small>Acceptance check failed</small></span>
              <b>00:16</b>
            </div>
          </div>
          <div class="hero-visual-foot">
            <span>Task → agents → calls → outcome</span>
            <span>Cost <b>unknown</b></span>
          </div>
        </div>
      </section>
      <div
        class="task-examples container"
        aria-label="Examples of complex agent tasks"
      >
        <span>Code a feature</span>
        <span>Build a professional slide deck</span>
        <span>Write a novel</span>
        <span>Create a film</span>
      </div>
      <ValueSlider />
      <section
        class="integration-story container"
        aria-labelledby="integration-title"
      >
        <div>
          <h2 id="integration-title">
            More model choices.
            <br />
            Keep the workflow you know.
          </h2>
        </div>
        <div class="integration-points">
          <article>
            <h3>Ready-to-use models</h3>
            <p>
              Choose a model and get to work. We plan to combine direct
              connections with OpenRouter as an optional fallback for broader
              model access.
            </p>
          </article>
          <article>
            <h3>Your agent. Your existing workflow.</h3>
            <p>
              Easy integration should preserve the tools and subscriptions you
              already use. Coding agents and their coding plans are one
              important starting point. Support for popular coding agents will
              be verified per agent and plan; additional paid model calls
              require explicit opt-in.
            </p>
          </article>
        </div>
      </section>
      <Benchmark />
      <section
        class="section container"
        id="product"
        aria-labelledby="product-title"
      >
        <div class="section-heading">
          <div>
            <h2 id="product-title">
              From “it ran”
              <br />
              to what happened.
            </h2>
          </div>
          <p>
            Before changing models, find out where the work goes. Inspect
            imported task evidence, trace repeated attempts, and distinguish
            verified outcomes from an agent’s completion claim.
          </p>
        </div>
        <div class="capability-grid">
          {capabilities.map((item) => (
            <article class="capability">
              <h3>{item.title}</h3>
              <p>{item.description}</p>
              <a class="text-link" href={item.href}>
                Explore {item.label.toLowerCase()}{" "}
                <span aria-hidden="true">↗</span>
              </a>
            </article>
          ))}
        </div>
        <div
          class="product-preview"
          aria-label="Illustrative task investigation preview with synthetic data"
        >
          <MockNavigation active={1} />
          <div class="mock-workspace">
            <div class="preview-toolbar">
              <div class="preview-brand">
                <strong>niu.io</strong>
                <span>Tasks</span>
              </div>
              <span class="sample-label">
                Illustrative view · Synthetic data
              </span>
            </div>
            <div class="preview-body">
              <div class="investigation">
                <div class="task-heading">
                  <div>
                    <p class="small-label">Parallel execution</p>
                    <h2>Follow every branch.</h2>
                  </div>
                  <span class="badge">Imported evidence</span>
                </div>
                <div class="metrics">
                  <div>
                    <span>Wall-clock duration</span>
                    <strong>
                      100 <small>ms</small>
                    </strong>
                  </div>
                  <div>
                    <span>Agent branches</span>
                    <strong>
                      2 <small>parallel</small>
                    </strong>
                  </div>
                  <div>
                    <span>Total task cost</span>
                    <strong class="unknown">
                      Unknown <span aria-hidden="true">◌</span>
                    </strong>
                  </div>
                </div>
                <div
                  class="timeline"
                  role="img"
                  aria-label="Example timeline: task lasts 100 milliseconds. Agent A runs from 0 to 70 milliseconds, Agent B from 10 to 90, and validation from 90 to 100. Parallel durations do not add up to task latency."
                >
                  <div class="time-axis">
                    <span>Execution timeline</span>
                    <div>
                      <span>0 ms</span>
                      <span>50 ms</span>
                      <span>100 ms</span>
                    </div>
                  </div>
                  {spans.map((span, i) => (
                    <div class="timeline-row">
                      <div class="span-name">
                        <span class={`span-icon icon-${i}`}>
                          {i === 0 ? "◇" : i === 3 ? "✓" : "↳"}
                        </span>
                        <span>
                          {span.name}
                          <small>{span.kind}</small>
                        </span>
                      </div>
                      <div class="track">
                        <span
                          class={`bar bar-${i}`}
                          style={`--offset:${span.offset}%;--width:${span.width}%`}
                        >
                          <span class="sr-only">{span.duration}</span>
                        </span>
                      </div>
                    </div>
                  ))}
                </div>
                <div class="evidence-row">
                  <div>
                    <span class="evidence-icon">↳</span>
                    <div>
                      <span class="small-label">AGENT CLAIM</span>
                      <strong>Completed</strong>
                    </div>
                  </div>
                  <div>
                    <span class="evidence-icon warning">!</span>
                    <div>
                      <span class="small-label">VALIDATOR RESULT</span>
                      <strong>Acceptance failed</strong>
                    </div>
                  </div>
                  <p>
                    A completion claim
                    <br />
                    isn’t an accepted outcome.
                  </p>
                </div>
              </div>
            </div>
            <div class="preview-caption">
              <span>Tasks → agents → invocations → outcomes</span>
              <a href={links.api}>
                Explore the execution API <span aria-hidden="true">↗</span>
              </a>
            </div>
          </div>
        </div>
        <div class="principle-note">
          <span aria-hidden="true">↳</span>
          <p>
            <strong>Missing evidence is useful information.</strong> An unknown
            model, unresolved charge or stale quota should be visible—not
            silently turned into a confident number.
          </p>
        </div>
      </section>
      <section
        class="gateway-section"
        id="gateway"
        aria-labelledby="gateway-title"
      >
        <div class="container section gateway-grid">
          <div>
            <h2 id="gateway-title">
              One entry point.
              <br />
              Your model connections.
            </h2>
            <p class="section-description">
              Connect a provider, issue a scoped key, and call the familiar
              OpenAI-compatible API. Keep provider credentials on your server.
              You can also investigate imported tasks without routing their
              model calls through Niu.
            </p>
            <ul class="gateway-features">
              <li>
                <span>01</span>OpenAI-compatible chat and streaming
              </li>
              <li>
                <span>02</span>Server-side provider credentials
              </li>
              <li>
                <span>03</span>Scoped client keys with rotation and revocation
              </li>
            </ul>
            <a class="text-link" href={links.quickstart}>
              Read the gateway quickstart <span aria-hidden="true">→</span>
            </a>
          </div>
          <div class="code-card">
            <div class="code-heading">
              <span>YOUR FIRST REQUEST</span>
              <span>cURL</span>
            </div>
            <pre><code>{requestExample}</code></pre>
            <div class="code-footnote">
              <span class="status-dot"></span>After configuring the{" "}
              <code>fast</code> model and issuing a client key.
            </div>
          </div>
        </div>
      </section>
      <section
        class="section container editions-section"
        id="editions"
        aria-labelledby="editions-title"
      >
        <div class="section-heading">
          <div>
            <h2 id="editions-title">
              Run on your servers.
              <br />
              Operate on your terms.
            </h2>
          </div>
          <p>
            Self-hosting belongs to both editions. Enterprise extends the
            open-source core for your organization’s identity, governance and
            infrastructure requirements.
          </p>
        </div>
        <div class="edition-cards">
          <article>
            <span class="phase available">OPEN SOURCE</span>
            <h3>Own the foundation.</h3>
            <p>
              For developers and teams who want an inspectable, self-hosted
              Agent Gateway.
            </p>
            <ul>
              <li>
                Deploy the public application and PostgreSQL on infrastructure
                you control.
              </li>
              <li>Inspect and modify the code under its published licenses.</li>
              <li>
                Evaluate model access, scoped keys, task imports and usage
                reporting.
              </li>
              <li>
                Run the community core without a private service or enterprise
                license.
              </li>
            </ul>
            <a class="button secondary" href={links.deployment}>
              Explore self-hosting <span aria-hidden="true">→</span>
            </a>
          </article>
          <article class="enterprise-card">
            <span class="phase">ENTERPRISE · PLANNED EXTENSIONS</span>
            <h3>Fit your enterprise.</h3>
            <p>
              For organizations deploying on company servers and integrating AI
              operations with internal systems.
            </p>
            <ul>
              <li>Federated identity and provisioning integrations.</li>
              <li>Advanced governance and retention controls.</li>
              <li>Private provider, agent and task integrations.</li>
              <li>Organization-specific model optimization policies.</li>
            </ul>
            <a
              class="button primary"
              href={`${links.release}#enterprise-boundary`}
            >
              Review enterprise scope <span aria-hidden="true">→</span>
            </a>
          </article>
        </div>
        <div class="enterprise-controls">
          <h3>Control where it runs and how it operates.</h3>
          <div>
            <article>
              <h4>Infrastructure</h4>
              <p>
                Choose where the application and database run. Manage network
                access, backups and upgrades within your own environment.
              </p>
            </article>
            <article>
              <h4>Data & credentials</h4>
              <p>
                Keep stored execution metadata and provider credentials in
                infrastructure you operate. Metadata imports exclude raw content
                by default.
              </p>
            </article>
            <article>
              <h4>Governance</h4>
              <p>
                Planned enterprise extensions connect identity and policy to
                internal systems while retaining core authorization and
                accounting checks.
              </p>
            </article>
          </div>
        </div>
        <p class="release-note">
          Both editions can be self-hosted. External model calls still send
          request data to the selected provider; deployment on company servers
          does not by itself make inference private or offline. Enterprise
          extensions and production qualification remain in progress.
        </p>
      </section>
      <section
        class="section container"
        id="release"
        aria-labelledby="release-title"
      >
        <div class="section-heading">
          <div>
            <h2 id="release-title">
              Know what you can
              <br />
              evaluate today.
            </h2>
          </div>
          <p>
            Evaluate the implementation today. Follow the published acceptance
            criteria as we qualify the first release.
          </p>
        </div>
        <div class="release-grid">
          <article class="release-card">
            <span class="phase available">
              <span class="status-dot"></span>AVAILABLE TO EVALUATE
            </span>
            <h3>Start with working paths.</h3>
            <ul>
              <li>Metadata import and task investigation</li>
              <li>Execution timelines and outcome evidence</li>
              <li>Scoped keys and compatible model access</li>
              <li>Settled usage and cost reporting</li>
              <li>Registered accounts and quota evidence</li>
            </ul>
            <a class="text-link" href={links.quickstart}>
              Try the development build <span aria-hidden="true">↗</span>
            </a>
          </article>
          <article class="release-card upcoming">
            <span class="phase">IN PROGRESS</span>
            <h3>Complete the release.</h3>
            <ul>
              <li>Supported native collectors</li>
              <li>Repeatable benchmarks and model fusion</li>
              <li>Coding-agent integrations that preserve existing plans</li>
              <li>Ready-to-use models with optional OpenRouter fallback</li>
              <li>Subscription inference and account pooling</li>
              <li>Broader provider and protocol qualification</li>
              <li>Production installation and recovery checks</li>
            </ul>
            <a class="text-link" href={links.release}>
              Read the release acceptance matrix{" "}
              <span aria-hidden="true">↗</span>
            </a>
          </article>
        </div>
        <p class="release-note">
          Development preview. The first feature-complete release is not yet
          production-qualified. Availability above describes implemented
          workflows, not completed release gates.
        </p>
      </section>
      <section
        class="section container start-section"
        id="start"
        aria-labelledby="start-title"
      >
        <div>
          <h2 id="start-title">
            Choose your
            <br />
            starting point.
          </h2>
          <p class="section-description">
            Start with one task or one model connection. Inspect the evidence
            before expanding to a larger workflow.
          </p>
        </div>
        <div class="start-paths">
          <a href={`${links.api}#standalone-execution-imports`}>
            <span class="path-number">01</span>
            <div>
              <h3>Investigate a task</h3>
              <p>
                Import authorized execution metadata and inspect it in the
                console.
              </p>
            </div>
            <span aria-hidden="true">↗</span>
          </a>
          <a href={links.quickstart}>
            <span class="path-number">02</span>
            <div>
              <h3>Make a model request</h3>
              <p>
                Configure a provider, issue a client key, and connect your
                application.
              </p>
            </div>
            <span aria-hidden="true">↗</span>
          </a>
          <a href={links.deployment}>
            <span class="path-number">03</span>
            <div>
              <h3>Run it yourself</h3>
              <p>
                Review the application and PostgreSQL setup before deploying.
              </p>
            </div>
            <span aria-hidden="true">↗</span>
          </a>
        </div>
      </section>
      <section
        class="section container faq-section"
        aria-labelledby="faq-title"
      >
        <div>
          <h2 id="faq-title">Before you start.</h2>
        </div>
        <div class="faq-list">
          {faqs.map((faq) => (
            <details>
              <summary>
                {faq.question}
                <span aria-hidden="true">+</span>
              </summary>
              <p>{faq.answer}</p>
            </details>
          ))}
        </div>
      </section>
      <section class="closing container">
        <div>
          <h2>Make every completed task count.</h2>
        </div>
        <a class="button primary" href={links.quickstart}>
          Try the development build <span aria-hidden="true">→</span>
        </a>
      </section>
    </main>
  </SiteLayout>
