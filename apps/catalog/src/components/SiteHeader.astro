---
import PublicHeader from '../../../docs/src/components/PublicHeader';
---
<script is:inline>
(()=>{let value='system';try{value=localStorage.getItem('niu-dashboard-theme')||'system';}catch{}const dark=value==='dark'||(value==='system'&&matchMedia('(prefers-color-scheme: dark)').matches);document.documentElement.classList.toggle('dark',dark);document.documentElement.style.colorScheme=dark?'dark':'light';})();
</script>
<PublicHeader path={Astro.url.pathname} brandSrc="/catalog-assets/brand/niu-mark.png" client:load/>
