---
import "@fontsource-variable/geist/wght.css";
import "@fontsource-variable/geist-mono/wght.css";
import "../styles/global.css";
import "../styles/public-ui.css";
import "../../../../branding/public-header.css";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";

interface Props {
  title: string;
  titleZh?: string;
  description: string;
}

const { title, titleZh = title, description } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const socialImage = new URL("/catalog-assets/brand/niu-social-en-dark.png", Astro.site);
---

<!doctype html>
<html lang="en" >
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#171714" />
    <link rel="icon" href="/catalog-assets/brand/favicon.ico" sizes="any" />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <title data-en={title} data-zh={titleZh}>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main" data-en="Skip to content" data-zh="跳转到主内容">Skip to content</a>
    <SiteHeader />
    <slot />
    <SiteFooter />
    <script is:inline>
      (() => {
        const title = document.querySelector('title[data-en][data-zh]');
        const sync = () => {
          const zh = document.documentElement.dataset.locale === 'zh-CN' || document.documentElement.lang === 'zh-CN';
          if (title) title.textContent = title.getAttribute(zh ? 'data-zh' : 'data-en') || '';
          document.querySelectorAll('[data-en][data-zh]').forEach(element => {
            element.textContent = element.getAttribute(zh ? 'data-zh' : 'data-en') || '';
          });
        };
        sync();
        window.addEventListener('niu-locale-change', sync);
        window.addEventListener('storage', sync);
      })();
    </script>
  </body>
</html>
