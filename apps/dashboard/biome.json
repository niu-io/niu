{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "files": {
    "includes": [
      "app/**/*.ts",
      "app/**/*.tsx",
      "app/**/*.css",
      "scripts/**/*.mjs",
      "test/**/*.ts",
      "test/**/*.tsx",
      "test/**/*.mjs"
    ]
  },
  "formatter": { "enabled": false },
  "assist": { "enabled": false },
  "linter": { "enabled": true, "rules": { "preset": "recommended" } },
  "css": { "parser": { "tailwindDirectives": true } }
}
