{
  "name": "@niu-io/dashboard",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "react-router dev --host 0.0.0.0",
    "build": "pnpm check:i18n:new && pnpm --dir ../../sdks/javascript build && react-router typegen && tsc -b && react-router build",
    "check": "pnpm --dir ../../sdks/javascript build && react-router typegen && tsc -b --pretty false && pnpm lint",
    "lint": "node scripts/check-hygiene.mjs && node scripts/check-module-size.mjs && node scripts/lint.mjs && node scripts/check-css-usage.mjs",
    "lint:update-baseline": "node scripts/lint.mjs --update-baseline",
    "test": "vitest run",
    "check:i18n": "node scripts/check-i18n.mjs",
    "check:i18n:new": "node scripts/check-i18n.mjs --new",
    "test:i18n": "node --test scripts/check-i18n.test.mjs"
  },
  "dependencies": {
    "@niu-io/sdk": "workspace:*",
    "@scalar/api-reference-react": "0.9.80",
    "@tabler/icons-react": "^3.48.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "katex": "^0.18.9",
    "lucide-react": "^1.48.0",
    "pinyin-pro": "^3.29.5",
    "radix-ui": "^1.6.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "react-router": "8.4.0",
    "recharts": "3.8.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.5",
    "@react-router/dev": "8.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^30.1.1",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.1",
    "vitest": "^5.0.1"
  }
}
