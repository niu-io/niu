{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://niu.io/contracts/enterprise/release-manifest.v1.schema.json",
  "title": "Niu Enterprise release manifest v1",
  "description": "Immutable build-time declaration of private HTTP services composed with one pinned Niu Gateway release.",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract", "niu_core", "modules"],
  "properties": {
    "contract": { "const": "niu.enterprise.release-manifest.v1" },
    "niu_core": {
      "type": "object",
      "additionalProperties": false,
      "required": ["git_commit", "api_version"],
      "properties": {
        "git_commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "api_version": { "$ref": "#/$defs/version" }
      }
    },
    "modules": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/module" }
    }
  },
  "$defs": {
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$",
      "maxLength": 100
    },
    "module": {
      "type": "object",
      "additionalProperties": false,
      "required": ["module_id", "module_version", "module_api_version", "core_api", "required", "socket_path", "health", "routes"],
      "properties": {
        "module_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$",
          "maxLength": 80
        },
        "module_version": { "$ref": "#/$defs/version" },
        "module_api_version": { "const": "niu.enterprise.service.v1" },
        "core_api": {
          "type": "object",
          "additionalProperties": false,
          "required": ["minimum", "maximum_exclusive"],
          "properties": {
            "minimum": { "$ref": "#/$defs/version" },
            "maximum_exclusive": { "$ref": "#/$defs/version" }
          }
        },
        "required": { "type": "boolean" },
        "socket_path": {
          "type": "string",
          "pattern": "^/run/niu/modules/[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*\\.sock$",
          "maxLength": 107
        },
        "health": {
          "type": "object",
          "additionalProperties": false,
          "required": ["live_path", "ready_path"],
          "properties": {
            "live_path": { "const": "/_niu/enterprise/v1/health/live" },
            "ready_path": { "const": "/_niu/enterprise/v1/health/ready" }
          }
        },
        "routes": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/route" }
        }
      }
    },
    "route": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path_prefix", "methods", "permission", "timeout_ms", "max_request_bytes", "max_response_bytes"],
      "properties": {
        "path_prefix": {
          "type": "string",
          "pattern": "^/enterprise/api/v1/[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*(?:/[a-zA-Z0-9_{}.-]+)*$",
          "maxLength": 200
        },
        "methods": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["GET", "POST", "PUT", "PATCH", "DELETE"] }
        },
        "permission": { "enum": ["read", "write", "manage_operators"] },
        "timeout_ms": { "type": "integer", "minimum": 1, "maximum": 30000 },
        "max_request_bytes": { "type": "integer", "minimum": 0, "maximum": 1048576 },
        "max_response_bytes": { "type": "integer", "minimum": 1, "maximum": 8388608 }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "methods": { "contains": { "enum": ["POST", "PUT", "PATCH", "DELETE"] } }
            },
            "required": ["methods"]
          },
          "then": {
            "properties": {
              "permission": { "enum": ["write", "manage_operators"] }
            }
          }
        }
      ]
    }
  }
}
