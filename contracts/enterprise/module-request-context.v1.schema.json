{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://niu.io/contracts/enterprise/module-request-context.v1.schema.json",
  "title": "Niu Enterprise module request context v1",
  "description": "JWT payload signed by the Niu Gateway for a single authenticated request to a registered module.",
  "type": "object",
  "additionalProperties": false,
  "required": ["iss", "aud", "sub", "iat", "exp", "jti", "niu"],
  "properties": {
    "iss": { "const": "https://niu.io" },
    "aud": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$", "maxLength": 80 },
    "sub": { "type": "string", "format": "uuid", "minLength": 36, "maxLength": 36 },
    "iat": { "type": "integer", "minimum": 0 },
    "exp": { "type": "integer", "minimum": 0 },
    "jti": { "type": "string", "format": "uuid" },
    "niu": {
      "type": "object",
      "additionalProperties": false,
      "required": ["organization_id", "role", "permission", "method", "path", "request_id", "body_sha256"],
      "properties": {
        "organization_id": { "type": "string", "format": "uuid", "minLength": 36, "maxLength": 36 },
        "project_id": { "type": "string", "format": "uuid", "minLength": 36, "maxLength": 36 },
        "role": { "enum": ["owner", "admin", "viewer"] },
        "permission": { "enum": ["read", "write", "manage_operators"] },
        "method": { "enum": ["GET", "POST", "PUT", "PATCH", "DELETE"] },
        "path": {
          "type": "string",
          "pattern": "^/enterprise/api/v1/",
          "maxLength": 2048,
          "description": "The complete request target: pathname followed by the original query string when present."
        },
        "request_id": { "type": "string", "format": "uuid", "minLength": 36, "maxLength": 36 },
        "body_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    }
  }
}
